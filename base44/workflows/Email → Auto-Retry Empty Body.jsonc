{
  "name": "Email \u2192 Auto-Retry Empty Body",
  "description": "Wenn eine neue inbound EmailMessageSandbox mit leerem Body (status=fetched) gespeichert wird, wird automatisch ein Retry des Body-Abrufs gestartet.",
  "trigger": {
    "condition": "${ ((.trigger.data.direction == \"inbound\") and (.trigger.data.processing_status == \"fetched\") and (.trigger.data.body_text == null or .trigger.data.body_text == \"\" or .trigger.data.body_text == [] or .trigger.data.body_text == {})) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "EmailMessageSandbox"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "email_auto_retry_empty_body",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "emailEngineRetryEmptyBodies",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "emailEngineRetryEmptyBodies"
  }
}