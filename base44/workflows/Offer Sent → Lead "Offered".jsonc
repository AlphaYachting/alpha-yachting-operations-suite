{
  "name": "Offer Sent \u2192 Lead \"Offered\"",
  "description": "When an Offer is set to \"Sent\", update the originating Lead status to \"Offered\".",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"Sent\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Offer"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "offer_sent_lead_offered",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "markLeadOfferedOnOfferSent",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "markLeadOfferedOnOfferSent"
  }
}