{
  "name": "Notify: Neue Work Order Zuweisung",
  "description": "Benachrichtigt neu zugewiesene Techniker per E-Mail und In-App wenn sie einer Work Order hinzugef\u00fcgt werden.",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"assigned_technicians\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "WorkOrder"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notify_neue_work_order_zuweisung",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyWorkOrderAssignment",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyWorkOrderAssignment"
  }
}