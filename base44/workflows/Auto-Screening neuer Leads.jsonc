{
  "name": "Auto-Screening neuer Leads",
  "description": "Pr\u00fcft jeden neu eingehenden Lead automatisch strukturell (Kontakt-, Boots-, Standortdaten) und erstellt zwei E-Mail-Entw\u00fcrfe (Nachfrage + Absage).",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Lead"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_screening_neuer_leads",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "screenIncomingLead",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "screenIncomingLead"
  }
}