{
  "name": "AttendanceRecord",
  "type": "object",
  "properties": {
    "technician_id": {
      "type": "string",
      "description": "Reference to Technician"
    },
    "technician_name": {
      "type": "string",
      "description": "Cached name for quick display"
    },
    "clock_in": {
      "type": "string",
      "format": "date-time",
      "description": "Clock-in timestamp (UTC) \u2014 null if manual/vacation entry"
    },
    "clock_out": {
      "type": "string",
      "format": "date-time",
      "description": "Clock-out timestamp (UTC) \u2014 null if still active"
    },
    "duration_minutes": {
      "type": "number",
      "description": "Calculated duration in minutes (set on clock-out)"
    },
    "clock_in_lat": {
      "type": "number",
      "description": "GPS latitude at clock-in"
    },
    "clock_in_lng": {
      "type": "number",
      "description": "GPS longitude at clock-in"
    },
    "clock_in_address": {
      "type": "string",
      "description": "Reverse-geocoded address at clock-in"
    },
    "clock_out_lat": {
      "type": "number",
      "description": "GPS latitude at clock-out"
    },
    "clock_out_lng": {
      "type": "number",
      "description": "GPS longitude at clock-out"
    },
    "clock_out_address": {
      "type": "string",
      "description": "Reverse-geocoded address at clock-out"
    },
    "notes": {
      "type": "string",
      "description": "Optional notes"
    },
    "work_date": {
      "type": "string",
      "format": "date",
      "description": "Date of work (derived from clock_in, used for grouping)"
    },
    "record_type": {
      "type": "string",
      "enum": [
        "clock_in",
        "manual_entry",
        "vacation",
        "sick_leave"
      ],
      "default": "clock_in",
      "description": "Type of attendance record"
    },
    "work_start_time": {
      "type": "string",
      "description": "HH:MM \u2014 manual work start time (for manual_entry)"
    },
    "work_end_time": {
      "type": "string",
      "description": "HH:MM \u2014 manual work end time (for manual_entry)"
    },
    "break_minutes": {
      "type": "number",
      "default": 0,
      "description": "Break time in minutes (for manual_entry)"
    }
  },
  "required": [
    "technician_id",
    "work_date"
  ]
}