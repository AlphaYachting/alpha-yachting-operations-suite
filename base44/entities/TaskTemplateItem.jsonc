{
  "name": "TaskTemplateItem",
  "type": "object",
  "properties": {
    "template_list_id": {
      "type": "string",
      "description": "Reference to TaskTemplateList"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Order of task in template"
    },
    "title": {
      "type": "string",
      "description": "Task title"
    },
    "description": {
      "type": "string",
      "description": "Task description"
    },
    "default_estimated_hours": {
      "type": "number",
      "description": "Default estimated duration in hours"
    },
    "default_role": {
      "type": "string",
      "enum": [
        "Mechanic",
        "Electrician",
        "Electronics Tech",
        "Rigging Specialist",
        "General Technician"
      ],
      "description": "Suggested technician role"
    },
    "default_required_vehicle": {
      "type": "boolean",
      "default": false,
      "description": "Whether task requires vehicle"
    },
    "required_tools_note": {
      "type": "string",
      "description": "Free-text note about required tools/inventory"
    },
    "is_optional": {
      "type": "boolean",
      "default": false,
      "description": "Whether task can be skipped"
    },
    "requires_customer_approval": {
      "type": "boolean",
      "default": false,
      "description": "Whether task needs customer approval"
    }
  },
  "required": [
    "template_list_id",
    "title"
  ]
}