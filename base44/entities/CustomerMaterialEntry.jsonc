{
  "name": "CustomerMaterialEntry",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Reference to Customer"
    },
    "job_id": {
      "type": "string",
      "description": "Reference to Job/Project \u2014 links this customer material to a specific project for billing review"
    },
    "work_order_id": {
      "type": "string",
      "description": "Reference to WorkOrder \u2014 directly links to the WO where this material was used, required for Ready-to-Invoice billing"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "import",
        "manual"
      ],
      "default": "import",
      "description": "How this entry was created"
    },
    "source_document_id": {
      "type": "string",
      "description": "Reference to ImportDocument (if import)"
    },
    "source_line_id": {
      "type": "string",
      "description": "Reference to ImportDocumentLine (if import)"
    },
    "supplier_name": {
      "type": "string",
      "description": "Supplier name"
    },
    "document_number": {
      "type": "string",
      "description": "Original document number"
    },
    "document_date": {
      "type": "string",
      "format": "date",
      "description": "Date of original document"
    },
    "item_title": {
      "type": "string",
      "description": "Item name"
    },
    "item_description": {
      "type": "string",
      "description": "Item description"
    },
    "quantity": {
      "type": "number",
      "description": "Quantity"
    },
    "unit": {
      "type": "string",
      "description": "Unit"
    },
    "unit_purchase_price": {
      "type": "number",
      "description": "Unit purchase price"
    },
    "total_purchase_price": {
      "type": "number",
      "description": "Total purchase price"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes"
    },
    "billing_status": {
      "type": "string",
      "enum": [
        "offen",
        "verrechnet"
      ],
      "default": "offen",
      "description": "Billing status \u2014 offen = not yet billed, verrechnet = billed to customer. Can be set manually or automatically via billing offer."
    },
    "staged_offer_id": {
      "type": "string",
      "description": "Reservation field \u2014 set when this entry is included in a pending billing Offer, before FIRA export. Prevents double-inclusion. Cleared if offer is cancelled/deleted."
    },
    "billed_offer_id": {
      "type": "string",
      "description": "Reference to Offer this entry was billed in \u2014 set on successful FIRA export, permanently prevents re-billing"
    },
    "billed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when this entry was included in a successful billing export"
    }
  },
  "required": [
    "customer_id",
    "item_title"
  ]
}