{
  "name": "Document",
  "type": "object",
  "properties": {
    "document_type": {
      "type": "string",
      "enum": [
        "Offer",
        "Invoice"
      ],
      "description": "Type of document"
    },
    "document_number": {
      "type": "string",
      "description": "Auto-generated document number"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Sent",
        "Accepted",
        "Rejected",
        "Expired",
        "Issued",
        "Partially Paid",
        "Paid",
        "Overdue",
        "Cancelled"
      ],
      "default": "Draft"
    },
    "issue_date": {
      "type": "string",
      "format": "date"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Due date for invoices"
    },
    "valid_until": {
      "type": "string",
      "format": "date",
      "description": "Valid until date for offers"
    },
    "customer_id": {
      "type": "string",
      "description": "Reference to Customer"
    },
    "boat_id": {
      "type": "string",
      "description": "Reference to Boat"
    },
    "location_id": {
      "type": "string",
      "description": "Reference to Location"
    },
    "currency": {
      "type": "string",
      "default": "EUR"
    },
    "language": {
      "type": "string",
      "enum": [
        "German",
        "English",
        "Italian",
        "Slovenian",
        "Croatian"
      ],
      "default": "German"
    },
    "payment_terms": {
      "type": "string",
      "default": "Net 14 days"
    },
    "internal_notes": {
      "type": "string"
    },
    "public_notes": {
      "type": "string",
      "description": "Notes shown on PDF"
    },
    "subtotal": {
      "type": "number",
      "default": 0
    },
    "tax_total": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number",
      "default": 0
    },
    "paid_amount": {
      "type": "number",
      "default": 0
    },
    "customer_name": {
      "type": "string"
    },
    "customer_address": {
      "type": "string"
    },
    "customer_vat": {
      "type": "string"
    },
    "boat_name": {
      "type": "string"
    },
    "boat_details": {
      "type": "string"
    },
    "location_name": {
      "type": "string"
    },
    "converted_from_offer_id": {
      "type": "string",
      "description": "Reference to offer if converted"
    }
  },
  "required": [
    "document_type",
    "customer_id"
  ]
}