{
  "name": "UnitSettings",
  "type": "object",
  "properties": {
    "value": {
      "type": "string",
      "description": "Internal unit value (e.g., 'Hour', 'Piece') - unique identifier"
    },
    "display": {
      "type": "string",
      "description": "Short display format (e.g., 'hrs', 'pcs')"
    },
    "label": {
      "type": "string",
      "description": "Full label (e.g., 'Hours', 'Pieces')"
    },
    "category": {
      "type": "string",
      "enum": [
        "Time",
        "Quantity",
        "Dimension",
        "Volume",
        "Weight",
        "Other"
      ],
      "default": "Other",
      "description": "Category for organizing units"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this unit is available for selection"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order in dropdown lists"
    }
  },
  "required": [
    "value",
    "display",
    "label"
  ]
}