{
  "name": "TaskRequiredResource",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "description": "Reference to Task (required)"
    },
    "inventory_item_id": {
      "type": "string",
      "description": "Specific inventory item required"
    },
    "inventory_category": {
      "type": "string",
      "description": "Or category of inventory required"
    },
    "requirement_type": {
      "type": "string",
      "enum": [
        "specific_item",
        "category"
      ],
      "default": "category",
      "description": "Type of requirement"
    },
    "quantity": {
      "type": "number",
      "default": 1,
      "description": "Quantity required"
    },
    "notes": {
      "type": "string",
      "description": "Requirement notes"
    }
  },
  "required": [
    "task_id"
  ]
}