{
  "name": "RepairOrder",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string",
      "description": "Auto-generated repair order reference e.g. RA-2026-0001"
    },
    "order_type": {
      "type": "string",
      "enum": [
        "repair",
        "storage"
      ],
      "default": "repair",
      "description": "Type of order: repair order or boat storage contract (Einlagerungsvertrag)"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Ready to Print",
        "Signed",
        "Converted"
      ],
      "default": "Draft",
      "description": "Repair order lifecycle status"
    },
    "accepted_by": {
      "type": "string",
      "description": "Name of the staff member who accepted the order"
    },
    "order_date": {
      "type": "string",
      "format": "date",
      "description": "Date the order was accepted"
    },
    "customer_name": {
      "type": "string",
      "description": "Customer name or company"
    },
    "customer_number": {
      "type": "string",
      "description": "Customer number"
    },
    "customer_address": {
      "type": "string",
      "description": "Street, postal code, city"
    },
    "customer_phone": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_tax_id": {
      "type": "string",
      "description": "OIB / Steuernummer / VAT-ID of the customer"
    },
    "customer_id": {
      "type": "string",
      "description": "Reference to Customer entity (once linked/created)"
    },
    "boat_type_model": {
      "type": "string",
      "description": "Boat type / model"
    },
    "boat_name": {
      "type": "string"
    },
    "boat_year": {
      "type": "string",
      "description": "Year of build"
    },
    "boat_registration": {
      "type": "string",
      "description": "Official registration / Kennzeichen"
    },
    "boat_hin": {
      "type": "string",
      "description": "Hull / HIN number"
    },
    "boat_length_m": {
      "type": "number",
      "description": "Length in meters"
    },
    "boat_beam_m": {
      "type": "number",
      "description": "Beam in meters"
    },
    "boat_draft_m": {
      "type": "number",
      "description": "Draft in meters"
    },
    "boat_value": {
      "type": "string",
      "description": "Declared value of the boat"
    },
    "boat_notes": {
      "type": "string",
      "description": "Special notes about the boat"
    },
    "boat_location": {
      "type": "string",
      "description": "Current location"
    },
    "engine_make_type": {
      "type": "string",
      "description": "Engine manufacturer / type"
    },
    "engine_power": {
      "type": "string",
      "description": "Power kW/PS"
    },
    "engine_hours": {
      "type": "string",
      "description": "Operating hours"
    },
    "boat_id": {
      "type": "string",
      "description": "Reference to Boat entity (once linked/created)"
    },
    "trailer_on_arrival": {
      "type": "boolean",
      "default": false,
      "description": "Boat arrives on trailer / customer has own trailer"
    },
    "trailer_stays": {
      "type": "boolean",
      "default": false,
      "description": "Trailer stays at Alpha Yachting"
    },
    "trailer_registration": {
      "type": "string"
    },
    "trailer_type": {
      "type": "string"
    },
    "trailer_max_weight": {
      "type": "string"
    },
    "trailer_condition_notes": {
      "type": "string",
      "description": "Condition / notes about the trailer"
    },
    "trailer_work": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Beleuchtung / Elektrik",
          "Reifen / R\u00e4der",
          "Bremsen / Auflaufeinrichtung",
          "Rahmen / Rost",
          "St\u00fctzrad / Seilwinde",
          "Sliprollen / Auflagen"
        ]
      },
      "description": "Requested trailer work categories"
    },
    "work_categories": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Motor / Antrieb",
          "Elektrik / Elektronik",
          "Rumpf / Gelcoat",
          "Osmose / Unterwasserschiff",
          "Antifouling",
          "Rigg / Segel",
          "Winterlager / Konservierung",
          "Kranung / Transport",
          "Anh\u00e4nger"
        ]
      },
      "description": "Requested work categories"
    },
    "work_description": {
      "type": "string",
      "description": "Description of defect / requested works"
    },
    "positions": {
      "type": "array",
      "description": "Line items / positions to be executed",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "string"
          },
          "price": {
            "type": "number"
          }
        }
      }
    },
    "hourly_rate": {
      "type": "number",
      "description": "Hourly rate net EUR"
    },
    "cost_cap": {
      "type": "number",
      "description": "Cost ceiling before callback EUR"
    },
    "expected_completion": {
      "type": "string",
      "description": "Expected completion date/text"
    },
    "cost_estimate_wanted": {
      "type": "boolean",
      "default": false
    },
    "test_drive_wanted": {
      "type": "boolean",
      "default": false
    },
    "dispose_old_parts": {
      "type": "boolean",
      "default": false
    },
    "storage_interval": {
      "type": "string",
      "enum": [
        "T\u00e4glich",
        "W\u00f6chentlich",
        "Monatlich",
        "J\u00e4hrlich",
        "Winterlagerung / Saisonlagerung",
        "Sonstiges"
      ],
      "description": "Desired storage interval (Einlagerung)"
    },
    "storage_interval_other": {
      "type": "string",
      "description": "Free text if storage_interval is Sonstiges"
    },
    "storage_start_date": {
      "type": "string",
      "format": "date",
      "description": "Storage start date"
    },
    "storage_end_date": {
      "type": "string",
      "format": "date",
      "description": "Expected storage end date"
    },
    "storage_under_roof": {
      "type": "string",
      "enum": [
        "Ja",
        "Nein",
        "Nach Verf\u00fcgbarkeit"
      ],
      "description": "Storage under roof"
    },
    "storage_location": {
      "type": "string",
      "description": "Storage site / location"
    },
    "storage_price": {
      "type": "number",
      "description": "Agreed storage price EUR"
    },
    "storage_billing_type": {
      "type": "string",
      "enum": [
        "Pro Tag",
        "Pro Woche",
        "Pro Monat",
        "Pro Jahr / Saison",
        "Pauschalpreis"
      ],
      "description": "Storage billing type"
    },
    "storage_extra_costs": {
      "type": "string",
      "description": "Other agreed costs / Nebenkosten"
    },
    "storage_services": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Selected additional storage services (Zusatzleistungen)"
    },
    "storage_services_notes": {
      "type": "string",
      "description": "Additional service orders / free list"
    },
    "boat_condition_ok": {
      "type": "boolean",
      "description": "Boat handed over without visible external damage"
    },
    "boat_condition_damages": {
      "type": "string",
      "description": "Visible damages / defects at handover"
    },
    "photos_status": {
      "type": "string",
      "enum": [
        "Wurden erstellt",
        "Werden noch erstellt",
        "Nicht erstellt"
      ],
      "description": "Status of handover photos / protocol"
    },
    "boat_insured": {
      "type": "boolean",
      "description": "Boat is insured"
    },
    "insurance_company": {
      "type": "string",
      "description": "Insurance company"
    },
    "insurance_policy_number": {
      "type": "string",
      "description": "Insurance policy / contract number"
    },
    "special_agreements": {
      "type": "string",
      "description": "Special agreements (Besondere Vereinbarungen)"
    },
    "extracted_documents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs of uploaded source documents"
    },
    "chat_transcript": {
      "type": "array",
      "description": "AI chat conversation transcript",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        }
      }
    },
    "converted_job_id": {
      "type": "string",
      "description": "Reference to Job once converted"
    },
    "source_offer_id": {
      "type": "string",
      "description": "Reference to Offer whose data was applied (storage contracts)"
    }
  },
  "required": []
}