{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "lead_technician",
        "technician",
        "customer"
      ],
      "default": "technician",
      "description": "User role: admin = full access, lead_technician = projects+leads+offers+schedule, technician = my tasks+schedule only, customer = mobile portal only"
    }
  },
  "required": []
}