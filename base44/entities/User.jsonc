    "role": {
      "type": "string",
      "enum": [
        "admin",
        "lead_technician",
        "technician",
        "customer"
      ],
      "default": "technician",
      "description": "User role"
    },
    "preferred_language": {
      "type": "string",
      "enum": [
        "de",
        "en"
      ],
      "default": "de",
      "description": "Preferred UI language for mobile app (de=German, en=English)"
    }
  },
  "required": []
}