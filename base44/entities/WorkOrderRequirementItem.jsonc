{
  "name": "WorkOrderRequirementItem",
  "type": "object",
  "properties": {
    "requirement_list_id": {
      "type": "string",
      "description": "Reference to WorkOrderRequirementList"
    },
    "work_order_id": {
      "type": "string",
      "description": "Reference to WorkOrder for direct filtering"
    },
    "task_id": {
      "type": "string",
      "description": "Optional link to source Task"
    },
    "type": {
      "type": "string",
      "enum": [
        "SparePart",
        "Material",
        "Tool",
        "Vehicle",
        "Other"
      ],
      "default": "Material",
      "description": "Type of requirement - SparePart is first-class"
    },
    "name": {
      "type": "string",
      "description": "Name/description of the requirement"
    },
    "quantity": {
      "type": "number",
      "description": "Required quantity"
    },
    "unit": {
      "type": "string",
      "enum": [
        "pcs",
        "l",
        "m",
        "kg",
        "set",
        "box",
        "roll",
        "meter"
      ],
      "default": "pcs",
      "description": "Unit of measurement"
    },
    "priority": {
      "type": "string",
      "enum": [
        "High",
        "Medium",
        "Low"
      ],
      "default": "Medium",
      "description": "Priority level"
    },
    "procurement_status": {
      "type": "string",
      "enum": [
        "NeedsClarification",
        "ToOrder",
        "Ordered",
        "Available",
        "Packed",
        "NotNeeded"
      ],
      "default": "ToOrder",
      "description": "Procurement workflow status"
    },
    "checklist_state": {
      "type": "string",
      "enum": [
        "Missing",
        "ConfirmedAvailable",
        "Purchased",
        "Packed"
      ],
      "default": "Missing",
      "description": "Technician checklist state"
    },
    "checked": {
      "type": "boolean",
      "default": false,
      "description": "Simple shopping list checkbox"
    },
    "checked_at": {
      "type": "string",
      "format": "date-time",
      "description": "When item was checked"
    },
    "checked_by_user_id": {
      "type": "string",
      "description": "User who checked the item"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes or clarifications"
    },
    "responsible_user_id": {
      "type": "string",
      "description": "Organizer or technician responsible for this item"
    },
    "inventory_item_id": {
      "type": "string",
      "description": "Link to existing InventoryItem or Tool"
    },
    "origin": {
      "type": "string",
      "enum": [
        "Manual",
        "AI",
        "AutoGenerated"
      ],
      "default": "Manual",
      "description": "How this item was created"
    }
  },
  "required": [
    "requirement_list_id",
    "work_order_id",
    "name",
    "type"
  ]
}