{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user receiving the notification"
    },
    "type": {
      "type": "string",
      "enum": [
        "work_order_assignment",
        "task_status_change",
        "work_order_reminder"
      ],
      "description": "Type of notification"
    },
    "title": {
      "type": "string",
      "description": "Notification title"
    },
    "message": {
      "type": "string",
      "description": "Notification message"
    },
    "related_work_order_id": {
      "type": "string",
      "description": "Reference to WorkOrder if applicable"
    },
    "related_task_id": {
      "type": "string",
      "description": "Reference to Task if applicable"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Whether notification has been read"
    },
    "email_sent": {
      "type": "boolean",
      "default": false,
      "description": "Whether email was sent"
    }
  },
  "required": [
    "user_email",
    "type",
    "title",
    "message"
  ]
}