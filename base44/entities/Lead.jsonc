{
  "name": "Lead",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Reference to existing Customer (optional - for leads from existing customers)"
    },
    "name": {
      "type": "string",
      "description": "Contact person name"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address"
    },
    "boat_name": {
      "type": "string",
      "description": "Boat/vessel name"
    },
    "boat_details": {
      "type": "string",
      "description": "Type, length, engine, etc."
    },
    "location": {
      "type": "string",
      "description": "Marina or anchorage location"
    },
    "location_id": {
      "type": "string",
      "description": "Reference to Location entity if known"
    },
    "contact_method": {
      "type": "string",
      "enum": [
        "Phone",
        "Email",
        "Website",
        "Referral",
        "Other"
      ],
      "default": "Phone",
      "description": "How they contacted us"
    },
    "inquiry_type": {
      "type": "string",
      "enum": [
        "Service Inquiry",
        "Parts Request",
        "Maintenance",
        "Emergency",
        "Other"
      ],
      "default": "Service Inquiry",
      "description": "Type of inquiry"
    },
    "notes": {
      "type": "string",
      "description": "Initial notes or requirements"
    },
    "description": {
      "type": "string",
      "description": "Email, transcript, or detailed customer inquiry (used for task generation)"
    },
    "status": {
      "type": "string",
      "enum": [
        "New Incoming",
        "Needs Clarification",
        "Ready to Offer",
        "Offered",
        "Ordered / Confirmed",
        "Rejected"
      ],
      "default": "New Incoming",
      "description": "Lead status in the inquiry-to-order pipeline"
    },
    "converted_customer_id": {
      "type": "string",
      "description": "Reference to Customer if auto-created or converted"
    },
    "converted_boat_id": {
      "type": "string",
      "description": "Reference to Boat if auto-created or converted"
    },
    "converted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When customer/boat was created from this lead"
    },
    "last_contacted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When we last contacted them"
    },
    "priority": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High",
        "Urgent"
      ],
      "default": "Medium",
      "description": "Lead priority"
    },
    "created_offer_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "References to Offers created from this lead"
    },
    "assigned_to_user_id": {
      "type": "string",
      "description": "Reference to User entity - who is responsible for this lead"
    },
    "accepted_by_assignee": {
      "type": "boolean",
      "default": false,
      "description": "Whether the assigned user has confirmed they are working on this lead"
    },
    "auto_offer_error": {
      "type": "string",
      "description": "Error message if Ready-to-Offer automation failed"
    },
    "screening_status": {
      "type": "string",
      "enum": [
        "pending",
        "screened",
        "error"
      ],
      "description": "Status of the automatic incoming-lead screening"
    },
    "screening_completeness": {
      "type": "string",
      "enum": [
        "complete",
        "incomplete",
        "unclear"
      ],
      "description": "Overall data-quality verdict from the automatic screening"
    },
    "screening_language": {
      "type": "string",
      "description": "Detected language of the lead inquiry (e.g. Deutsch, English)"
    },
    "screening_summary": {
      "type": "string",
      "description": "Short human-readable summary of the screening result"
    },
    "screening_checks": {
      "type": "array",
      "description": "Structured per-area screening results",
      "items": {
        "type": "object",
        "properties": {
          "area": {
            "type": "string",
            "description": "contact | boat | location"
          },
          "status": {
            "type": "string",
            "description": "ok | missing | unclear"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "screening_missing_info": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of missing or unclear data points"
    },
    "draft_followup_subject": {
      "type": "string",
      "description": "Auto-generated verification/follow-up email subject"
    },
    "draft_followup_body": {
      "type": "string",
      "description": "Auto-generated verification/follow-up email body"
    },
    "draft_rejection_subject": {
      "type": "string",
      "description": "Auto-generated polite rejection email subject"
    },
    "draft_rejection_body": {
      "type": "string",
      "description": "Auto-generated polite rejection email body"
    },
    "screened_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the automatic screening last ran"
    },
    "email_response_status": {
      "type": "string",
      "enum": [
        "none",
        "drafted",
        "sent"
      ],
      "default": "none",
      "description": "Tracks manual email response action: none = nothing yet, drafted = copied to clipboard, sent = Send button clicked (mail client opened)"
    },
    "email_response_type": {
      "type": "string",
      "enum": [
        "followup",
        "rejection"
      ],
      "description": "Which draft was last acted upon (nachfrage/absage)"
    },
    "email_response_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the send/copy action was last triggered"
    }
  },
  "required": [
    "name",
    "phone"
  ]
}